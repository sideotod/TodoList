{
  "name": "todolist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && pnpm typecheck:sw && node --experimental-strip-types scripts/generate-sw.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:sw": "tsc --noEmit --project tsconfig.sw.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test": "pnpm test:unit",
    "test:e2e": "playwright test --config playwright.preview.config.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "6.2.5",
    "jiti": "2.7.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
